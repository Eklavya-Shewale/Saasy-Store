# Local PostgreSQL settings. Replace DB_PASSWORD locally; never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saasy_store
DB_USERNAME=saasy_store
DB_PASSWORD=change-me

# Google OAuth/OIDC administrator login. Obtain these from Google Cloud; never commit real values.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ADMIN_EMAIL=admin@example.com
# Must exactly match an Authorized redirect URI configured in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
